FROM node:22-bookworm-slim

ENV PYTHON=python3 \
    NODE_ENV=production

RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 poppler-utils ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace/app

RUN corepack enable \
    && corepack prepare pnpm@9.15.9 --activate

COPY app/package.json app/pnpm-lock.yaml ./
RUN pnpm install --prod --frozen-lockfile

COPY app/tsconfig.json ./tsconfig.json
COPY app/src ./src
COPY app/convex/shared/document_builders.ts ./convex/shared/document_builders.ts
COPY app/scripts/extract_visible_links.py app/scripts/guard_posting.py app/scripts/json_io.py app/scripts/robots_decision.py ./scripts/
COPY tools/page_decode.py tools/posting_guard.py tools/robots_check.py tools/verify_pdf.py /workspace/tools/

EXPOSE 10000
CMD ["node", "--experimental-strip-types", "src/hosted-worker.ts"]
