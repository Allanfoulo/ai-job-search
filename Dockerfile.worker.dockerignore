# Render builds this worker with a narrow, explicit allowlist. Candidate data,
# local settings, application drafts, source postings, and repo history stay out.
**
!app/
app/*
!app/package.json
!app/pnpm-lock.yaml
!app/tsconfig.json
!app/src/
app/src/*
!app/src/hosted-worker.ts
!app/src/pdf/
app/src/pdf/*
!app/src/pdf/render-application-pdf.tsx
!app/src/components/
app/src/components/*
!app/src/components/pdf/
!app/src/components/pdf/**
!app/src/lib/
app/src/lib/*
!app/src/lib/pdf-primitives.tsx
!app/src/lib/resolve-color.ts
!app/src/lib/pdf-themes/
!app/src/lib/pdf-themes/**
!app/src/types/
app/src/types/*
!app/src/types/pdf-components.ts
!app/src/types/pdf-themes.ts
!app/convex/
app/convex/*
!app/convex/shared/
app/convex/shared/*
!app/convex/shared/document_builders.ts
!app/scripts/
app/scripts/*
!app/scripts/extract_visible_links.py
!app/scripts/guard_posting.py
!app/scripts/json_io.py
!app/scripts/robots_decision.py
!tools/
tools/*
!tools/page_decode.py
!tools/posting_guard.py
!tools/robots_check.py
!tools/verify_pdf.py
